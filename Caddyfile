# =============================================================================
# Concord — Caddy (desenvolvimento)
#
# Por que existe um proxy já em dev:
# frontend e backend precisam compartilhar a MESMA ORIGEM. É isso que permite
# o cookie de sessão com SameSite=Lax funcionar igual em dev e em produção
# (ADR-02). Sem isso, o dev roda num mundo e a produção em outro.
#
# http://localhost é considerado "secure context" pelos navegadores, então
# getUserMedia() e getDisplayMedia() funcionam sem TLS em desenvolvimento.
# =============================================================================

{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# Backend Spring Boot. O context-path da aplicação já é /api, então o
	# caminho é repassado inteiro — sem strip_prefix, que quebraria redirects.
	#
	# Cobre também o WebSocket em /api/ws: o Caddy detecta o cabeçalho Upgrade
	# e faz a troca de protocolo sozinho, sem configuração adicional. O cookie
	# de sessão viaja no handshake como em qualquer requisição HTTP — é o que
	# permite REST e WebSocket reconhecerem a mesma identidade.
	handle /api/* {
		reverse_proxy backend:8080 {
			# X-Forwarded-Proto NAO e sobrescrito aqui.
			#
			# O Caddy ja repassa o valor recebido quando ele existe. Atras de
			# outro proxy que termina TLS — ngrok, Cloudflare, um balanceador —
			# o cabecalho chega valendo "https", e e esse valor que interessa:
			# ele diz o esquema que o NAVEGADOR usou, nao o deste salto.
			#
			# Forcar {scheme} escrevia "http" e fazia o Spring reconstruir a
			# origem como http://dominio, comparando-a com o Origin
			# https://dominio do navegador. Origens diferentes, handshake do
			# WebSocket recusado, nada em tempo real.
			header_up X-Real-IP {remote_host}
		}
	}

	# Frontend Next.js. O catch-all cobre também o WebSocket do hot reload
	# (/_next/webpack-hmr); o Caddy faz o upgrade automaticamente.
	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}

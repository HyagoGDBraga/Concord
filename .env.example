# =============================================================================
# Concord — variáveis de ambiente
#
#   cp .env.example .env    e preencha os valores vazios.
#   O arquivo .env NUNCA deve ser commitado (já está no .gitignore).
#
# Marcações:
#   [F1] usado desde a Fase 1
#   [F2] necessário a partir da Fase 2 (autenticação)
#   [F5] necessário a partir da Fase 5 (WebRTC/TURN)
#   [F9] necessário a partir da Fase 9 (produção)
# =============================================================================

# --- Banco de dados ------------------------------------------------- [F1] ---
POSTGRES_DB=concord
POSTGRES_USER=concord
# Em desenvolvimento pode ser qualquer valor. Em produção, gere com:
#   openssl rand -base64 32
POSTGRES_PASSWORD=concord_dev_password
DATABASE_URL=jdbc:postgresql://postgres:5432/concord

# --- Aplicação ------------------------------------------------------ [F1] ---
SPRING_PROFILES_ACTIVE=dev
APP_PUBLIC_URL=http://localhost

# --- Sessão (ADR-02: sessão opaca em cookie, não JWT) --------------- [F2] ---
SESSION_COOKIE_NAME=concord_session
# Tempo de inatividade até a sessão expirar.
SESSION_TIMEOUT=7d
# Em produção precisa ser true (exige HTTPS). Em dev, false.
SESSION_COOKIE_SECURE=false

# --- Cadastro (D-03: aberto, com contenção) ------------------------- [F2] ---
# Valor INICIAL. Depois da primeira subida, quem manda é a tabela app_settings,
# alterável pelo administrador em PATCH /api/admin/settings.
REGISTRATION_OPEN=true
# Contas que nunca confirmam o e-mail são expurgadas após este prazo.
UNVERIFIED_ACCOUNT_TTL=7d

# --- Bootstrap do primeiro administrador ---------------------------- [F2] ---
# A conta com este e-mail é promovida a ADMIN quando verificar o e-mail.
# O estado "concluído" é PERSISTENTE (app_settings). Depois que existir um
# administrador, alterar esta variável não promove mais ninguém.
# Esvazie a variável após o primeiro uso.
CONCORD_BOOTSTRAP_ADMIN_EMAIL=

# --- E-mail transacional (verificação de conta e reset de senha) ---- [F2] ---
# Dev: Mailpit, sem autenticação e sem TLS. Nenhum e-mail sai para a internet.
# Produção: provedor transacional externo — troque host/porta/credenciais e
# ligue SMTP_AUTH e SMTP_STARTTLS. Nenhuma linha de código muda (EmailProvider).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=nao-responda@concord.local

# --- CORS ----------------------------------------------------------- [F2] ---
# Com Caddy servindo tudo na mesma origem, isto fica restritivo por padrão.
CORS_ALLOWED_ORIGINS=http://localhost

# --- TURN / STUN ---------------------------------------------------- [F5] ---
TURN_REALM=concord.local
# Gere com: openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=
TURN_PUBLIC_IP=

# --- Frontend (inlined no build; nunca coloque segredo aqui) -------- [F1] ---
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=ws://localhost/api/ws
NEXT_PUBLIC_STUN_URL=stun:localhost:3478
NEXT_PUBLIC_TURN_URL=turn:localhost:3478

# --- Produção ------------------------------------------------------- [F9] ---
# Domínio usado pelo Caddy para emitir o certificado TLS automaticamente.
APP_DOMAIN=concord.exemplo.com
ACME_EMAIL=voce@exemplo.com

# --- WebRTC: STUN e TURN -------------------------------------------------- [F5] ---
# Em desenvolvimento na mesma maquina ou na mesma rede local, o STUN resolve e o
# TURN nem chega a ser usado. Suba o coturn so quando precisar:
#     docker compose --profile turn up -d
TURN_ENABLED=false

# STUN publico do Google em dev. Em producao, aponte para o seu proprio coturn:
# um STUN de terceiro ve o IP publico de todo mundo que faz chamada aqui.
TURN_STUN_URL=stun:stun.l.google.com:19302

# Enderecos do TURN, separados por virgula. UDP e o caminho normal; TCP e o
# recurso para redes que bloqueiam UDP.
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp

# Segredo compartilhado com o coturn. O backend deriva dele as credenciais
# efemeras por HMAC; ele NUNCA e enviado ao navegador.
# Gere com: openssl rand -hex 32
TURN_SECRET=troque-este-segredo-antes-de-usar

# Dominio do realm do TURN.
TURN_REALM=concord.local

# IP publico do servidor, necessario quando o coturn roda atras de NAT (VPS com
# IP flutuante, por exemplo). Em dev pode ficar vazio.
TURN_EXTERNAL_IP=127.0.0.1
